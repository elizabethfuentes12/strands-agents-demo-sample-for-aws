<mxfile host="app.diagrams.net" type="device">
  <diagram name="Architecture" id="strands-demos-arch">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Strands Agents Demo Showcase — Architecture" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;fontColor=#00cc5f;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="500" height="30" as="geometry" />
        </mxCell>

        <mxCell id="browser" value="Browser SPA&#10;(React + Vite, dark theme)&#10;EN / ES / PT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17181c;strokeColor=#00cc5f;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="cognito" value="Amazon Cognito&#10;User Pool (kiosk login)&#10;JWT auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232533;strokeColor=#3d50f5;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="appsync" value="AWS AppSync Events&#10;(serverless WebSockets)&#10;inbox/&lt;demo&gt;/&lt;session&gt;&#10;out/&lt;demo&gt;/&lt;session&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17181c;strokeColor=#00cc5f;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="115" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="dispatcher" value="Dispatcher Lambda&#10;invoke_agent_runtime&#10;(session ≥33 chars,&#10;retries 424/429/500,&#10;read_timeout 900s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232533;strokeColor=#ff9900;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="270" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="runtime" value="AgentCore Runtime&#10;ONE per demo (01–10)&#10;code-based ZIP on S3&#10;Strands Agent + tools + hooks&#10;→ typed JSON events (SSE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17181c;strokeColor=#00cc5f;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="260" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="bedrock" value="Amazon Bedrock&#10;Amazon Nova Pro&#10;(us.amazon.nova-pro-v1:0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232533;strokeColor=#3d50f5;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="120" width="220" height="80" as="geometry" />

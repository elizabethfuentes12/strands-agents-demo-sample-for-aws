        <mxCell id="cf" value="CloudFront + S3 (OAC)&#10;static site hosting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232533;strokeColor=#ff9900;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cw" value="CloudWatch&#10;GenAI Observability&#10;(OTEL traces)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232533;strokeColor=#3d50f5;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="430" width="220" height="60" as="geometry" />
